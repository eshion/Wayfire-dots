	<description>使用 7zip 解压压缩包</description>
	<range>*</range>
	<patterns>*</patterns>
	<other-files/>
</action>
<action>
	<icon>gnome-log</icon>
	<name>bookokrat</name>
	<submenu></submenu>
	<unique-id>1783146874537918-2</unique-id>
