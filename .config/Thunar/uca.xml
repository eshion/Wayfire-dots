	<description>Example for a custom action</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon></icon>
	<name>7z</name>
	<submenu></submenu>
	<unique-id>1783145508748931-1</unique-id>
